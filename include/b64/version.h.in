/*
version.h - libb64 version information.

Generated from the top-level VERSION file by CMake (configure_file). Do not
edit this file or the generated version.h; change /VERSION instead -- it is
the single source of truth, consumed by both the build and these macros.
*/
#ifndef BASE64_VERSION_H
#define BASE64_VERSION_H

#define BASE64_VERSION_MAJOR  @PROJECT_VERSION_MAJOR@
#define BASE64_VERSION_MINOR  @PROJECT_VERSION_MINOR@
#define BASE64_VERSION_PATCH  @PROJECT_VERSION_PATCH@
#define BASE64_VERSION_STRING "@PROJECT_VERSION@"

/* Single integer for ordered comparisons, e.g. 2.0.0 -> 20000. */
#define BASE64_VERSION (BASE64_VERSION_MAJOR * 10000 \
                        + BASE64_VERSION_MINOR * 100 \
                        + BASE64_VERSION_PATCH)

#endif /* BASE64_VERSION_H */
